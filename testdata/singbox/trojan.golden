{
  "dns": {
    "final": "remote",
    "servers": [
      {
        "detour": "proxy",
        "server": "1.1.1.1",
        "tag": "remote",
        "type": "https"
      },
      {
        "detour": "proxy",
        "server": "8.8.8.8",
        "tag": "remote-1",
        "type": "https"
      },
      {
        "tag": "local",
        "type": "local"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    },
    "clash_api": {
      "default_mode": "rule",
      "external_controller": "127.0.0.1:9090"
    }
  },
  "inbounds": [
    {
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "interface_name": "tun0",
      "mtu": 9000,
      "stack": "system",
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    },
    {
      "listen": "127.0.0.1",
      "listen_port": 10808,
      "tag": "mixed-in",
      "type": "mixed"
    }
  ],
  "log": {
    "level": "info"
  },
  "outbounds": [
    {
      "password": "secret",
      "server": "192.0.2.5",
      "server_port": 443,
      "tag": "proxy",
      "tls": {
        "enabled": true,
        "server_name": "front.example.com"
      },
      "type": "trojan"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "block",
      "type": "block"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "local"
    },
    "final": "proxy",
    "rules": [
      {
        "action": "hijack-dns",
        "port": 53
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "action": "reject",
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ]
      },
      {
        "action": "route",
        "ip_is_private": true,
        "outbound": "direct"
      }
    ]
  }
}
